{
  "name": "vortex-learning-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:ui",
    "dev:ui": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:api\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "npm run dev",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.build.json",
    "start": "node dist-server/server/index.js",
    "build": "tsc -b && npm run typecheck:server && npm run build:server && vite build",
    "preview": "npm run preview:ui",
    "preview:ui": "concurrently -k \"vite preview --host 127.0.0.1\" \"npm:dev:api\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
