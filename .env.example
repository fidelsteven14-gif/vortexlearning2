PORT=3001
HOST=127.0.0.1
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=data/vortex-learning.sqlite
RESOURCE_STORAGE_PATH=data/resources
# Comma-separated exact frontend origins allowed to call this API.
# Add the deployed GitHub Pages origin here, e.g. https://owner.github.io.
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
APP_URL=http://127.0.0.1:4173
SUPPORT_EMAIL=vortexlearning0@gmail.com
VITE_SUPPORT_EMAIL=vortexlearning0@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Set MAIL_PASSWORD locally to the Gmail app password for MAIL_USER; never expose it to the frontend.
MAIL_USER=vortexlearning0@gmail.com
MAIL_FROM=vortexlearning0@gmail.com
MAIL_PASSWORD=
# Create a Web OAuth client in Google Cloud; authorize your exact site origin.
# Set the same public client ID for both the server validator and the frontend GIS button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# If you need to create a platform-owner account, do it through the normal sign-in flow
# and keep the administrator role in the database. Do not use a separate admin login page.
# Include an email address for email-based sign-in when creating the platform owner.
# ADMIN_NAME=Platform Owner
# ADMIN_USERNAME=platform-owner
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-6-characters
